@admin_email = sanchai-t@rmutp.ac.th
@admin_password = tonkla2548
@user_email = user01@example.com
@user_password = User@1234

### 1. Admin
### 1.1 Register (admin) one time for first time to create admin account
POST http://localhost:9091/admin/register-admin
Content-Type: application/json

{
    "firstname": "Sanchai",
    "lastname": "Tangjai",
    "email": "sanchai-t@rmutp.ac.th",
    "password": "tonkla2548"
}

### 1.2 Login
POST http://localhost:9091/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.3 Forgot Password
POST http://localhost:9091/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password (ใช้ token จาก email)
POST http://localhost:9091/admin/reset-password
Content-Type: application/json

{
    "password": "tonkla2548",
    "passwordConfirmation": "tonkla2548",
    "code": "<token-from-email>"
}

### 1.4 Profile
GET http://localhost:9091/admin/users/me
Authorization: Bearer <admin-jwt-token>

### 2. User
### 2.1 Register
POST http://localhost:9091/api/auth/local/register
Content-Type: application/json

{
    "username": "user01",
    "email": "user01@example.com",
    "password": "User@1234"
}

### 2.2 Login
POST http://localhost:9091/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
POST http://localhost:9091/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password (ใช้ token จาก email)
POST http://localhost:9091/api/auth/reset-password
Content-Type: application/json

{
    "password": "User@1234",
    "passwordConfirmation": "User@1234",
    "code": "<token-from-email>"
}

### 2.4 Profile
GET http://localhost:9091/api/users/me
Authorization: Bearer <user-jwt-token>
