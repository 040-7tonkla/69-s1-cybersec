{
  "name": "Admin REST API",
  "base_url": "http://localhost:9091",
  "operations": {
    "register": {
      "method": "POST",
      "url": "/api/auth/local/register",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "username": "admin01",
        "email": "admin@example.com",
        "password": "Admin@1234"
      }
    },
    "login": {
      "method": "POST",
      "url": "/api/auth/local",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "identifier": "admin@example.com",
        "password": "Admin@1234"
      },
      "note": "เก็บ JWT จาก response เพื่อใช้ใน header: Authorization: Bearer <token>"
    },
    "forgot_password": {
      "method": "POST",
      "url": "/api/auth/forgot-password",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "admin@example.com"
      },
      "note": "ระบบจะส่ง email สำหรับ reset password"
    },
    "profile": {
      "method": "GET",
      "url": "/api/users/me",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <token>"
      },
      "note": "ต้อง login ก่อน แล้วใส่ JWT token ใน header"
    }
  }
}
